# saas-identity-platform-fastapi — pytest 测试期覆盖
# key 集合与 .env.example 严格相等（L0.5）；PG_DATABASE=saas_test。

# —— Server ——
SERVER_PORT=5107

# —— Database（saas_test 测试库, 全家族统一 PG_* 五件套） ——
PG_HOST=127.0.0.1
PG_PORT=54321
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=saas_test

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY) ——
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# —— 兼容 deploy 脚本（saas-identity-platform-fastapi.sh 用 DATABASE_URL 单串） ——
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/saas_test

# —— CORS allowed origins (SSO 跨域用) ——
# 5108 = saas-flutter dev（REQ-2026-002 Phase 2）
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:5101,http://localhost:5102,http://localhost:5103,http://localhost:5108
