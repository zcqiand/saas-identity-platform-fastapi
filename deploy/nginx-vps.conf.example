# VPS nginx vhost — saas-identity-platform-fastapi
#
# 这份是「参考模板」，不在 nginx include 路径里。.example 后缀让 nginx
# 不会把它当真；deploy 脚本每次部署都会从 master 重拉并渲染占位符
# （saas.YOUR_DOMAIN / your-cert.* → 实际域名与 cert）。
#
# 用法（manual）:
#   1. 复制:cp deploy/nginx-vps.conf.example /etc/nginx/sites-available/YOUR_DOMAIN
#   2. sed 替换 saas.YOUR_DOMAIN → 你的域名、your-cert.crt/key → 实际 cert 路径
#   3. 启用:ln -sf /etc/nginx/sites-available/YOUR_DOMAIN /etc/nginx/sites-enabled/
#   4. 同一台 VPS 上若已有 saas vhost 占了 default_server，删 sites-enabled/default
#   5. nginx -t && systemctl reload nginx
#
# 这份配置的目的:
#   - saas-fastapi.xiangru.uk 的 HTTP 301 到 HTTPS
#   - HTTPS 终结在 VPS（持 cert）
#   - proxy_pass 到本机容器端口 5107（host=container；ADR-0018 单层 port 方案，
#     由 docker run -p 127.0.0.1:5107:5107 决定；saas 后端段 X07）。

server {
    listen 80;
    server_name saas.YOUR_DOMAIN;            # 改:你的域名
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name saas.YOUR_DOMAIN;            # 改

    # cert / key 在 VPS 本地，**不入仓**
    ssl_certificate     /etc/nginx/ssl/your-cert.cert;   # 改
    ssl_certificate_key /etc/nginx/ssl/your-cert.key;    # 改

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 浏览器一年 HTTPS-only
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        # 容器内 uvicorn 监听 :5107，host=container=5107（Dockerfile CMD 钉死）
        # 改端口必须同步 Dockerfile CMD 与 deploy/saas-identity-platform-fastapi.sh 的 -p
        proxy_pass http://127.0.0.1:5107;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
